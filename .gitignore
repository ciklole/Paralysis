# ---------------------------------------------------------------------------
# Unity generated folders
# ---------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Aa]ssets/_Recovery/

# ---------------------------------------------------------------------------
# Asset meta data is only ignored when the asset itself is ignored
# ---------------------------------------------------------------------------
!/[Aa]ssets/**/*.meta

# ---------------------------------------------------------------------------
# Autogenerated IDE solution / project files
# ---------------------------------------------------------------------------
ExportedObj/
.consulo/
.idea/
.gradle/
.vs/
.vscode/
*.unityproj
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.tmp
*.opendb
*.VC.db
*.pdb
*.mdb
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---------------------------------------------------------------------------
# Unity3D generated meta files
# ---------------------------------------------------------------------------
sysinfo.txt
crashlytics-build.properties

# ---------------------------------------------------------------------------
# Builds / packages
# ---------------------------------------------------------------------------
*.apk
*.aab
*.app
*.unitypackage

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treaming[Aa]ssets/aa/*
!/[Aa]ssets/[Ss]treaming[Aa]ssets/aa.meta

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# ---------------------------------------------------------------------------
# Version control / tooling metadata
# ---------------------------------------------------------------------------
/.plastic/
/MVC Prefs/
/UIElementsSchema/

# Unity ignores folders whose name ends with "~" (installer + sample payloads)
/**/Samples~/
/**/Setup~/.meta

# ---------------------------------------------------------------------------
# Project specific exclusions
# ---------------------------------------------------------------------------
# Large third-party sample content that is not used by the game.
# The matching .meta files are excluded too, so no orphaned meta files
# are committed for folders that are not part of the project.
/Assets/vrbn_studios/
/Assets/vrbn_studios.meta
/Assets/BxB Studio/
/Assets/BxB Studio.meta
/Packages/dev.bxbstudio.*/

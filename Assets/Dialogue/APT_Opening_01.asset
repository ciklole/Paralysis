  - speaker: You
    speakerColor: {r: 0, g: 0, b: 0, a: 0}
    text: Ah, there it is. Bread, milk, eggs... I think that's everything.
    portrait: {fileID: 0}
    voiceClip: {fileID: 8300000, guid: 7c6b2a387d04b5b4dbdb3f56fa91c14b, type: 3}

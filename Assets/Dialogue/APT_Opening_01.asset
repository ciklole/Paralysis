    movementLock: 0
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  - speaker: You
    speakerColor: {r: 0, g: 0, b: 0, a: 0}
    text: Where did I put that shopping list?
    portrait: {fileID: 0}
    voiceClip: {fileID: 8300000, guid: 74333f1048ba52f4d962ab8dbe3227fc, type: 3}
    voiceVolume: 1
    soundEffect: {fileID: 0}

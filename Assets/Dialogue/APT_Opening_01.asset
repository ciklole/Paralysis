  - speaker: You
    speakerColor: {r: 0, g: 0, b: 0, a: 0}
    text: I should probably get some groceries before it gets too late.
    portrait: {fileID: 0}
    voiceClip: {fileID: 8300000, guid: 744686c0d141d08429b123ac9fe18dd0, type: 3}
    voiceVolume: 1

--- !u!114 &267583692
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 267583688}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 23d38a562da3cc542a0d2adaac287806, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CashierInteraction
  interactionKey: 101
  range: 3.5
  prompt: E - Talk to cashier
  priority: 0
  interactionPoint: {fileID: 395000696}
  successDialogue:
    sequence: {fileID: 0}
    conversationId: CASHIER_Success_01
    lockPlayerMovement: 1
    lines:
    - speaker: Cashier
      speakerColor: {r: 0, g: 0, b: 0, a: 0}
      text: Evening. Did you find everything you were looking for?
      portrait: {fileID: 0}
      voiceClip: {fileID: 0}
      voiceVolume: 1
      soundEffect: {fileID: 0}
      delayBefore: 0
      overrideTypewriter: 0
      useTypewriter: 1
      pauseAfter: 0.25
      movementLock: 0
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - speaker: You
      speakerColor: {r: 0, g: 0, b: 0, a: 0}
      text: Yeah. I got everything on the list.
      portrait: {fileID: 0}
      voiceClip: {fileID: 0}
      voiceVolume: 1
      soundEffect: {fileID: 0}
      delayBefore: 0
      overrideTypewriter: 0
      useTypewriter: 1
      pauseAfter: 0.25
      movementLock: 0
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - speaker: Cashier
      speakerColor: {r: 0, g: 0, b: 0, a: 0}
      text: Good. Let's get you checked out.
      portrait: {fileID: 0}
      voiceClip: {fileID: 0}
      voiceVolume: 1
      soundEffect: {fileID: 0}
      delayBefore: 0
      overrideTypewriter: 0
      useTypewriter: 1
      pauseAfter: 0.25
      movementLock: 0
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - speaker: Cashier
      speakerColor: {r: 0, g: 0, b: 0, a: 0}
      text: You live around here?
      portrait: {fileID: 0}
      voiceClip: {fileID: 0}
      voiceVolume: 1
      soundEffect: {fileID: 0}
      delayBefore: 1.5
      overrideTypewriter: 0
      useTypewriter: 1
      pauseAfter: 0.25
      movementLock: 0
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - speaker: You
      speakerColor: {r: 0, g: 0, b: 0, a: 0}
      text: Yeah. A few streets away.
      portrait: {fileID: 0}
      voiceClip: {fileID: 0}
      voiceVolume: 1
      soundEffect: {fileID: 0}
      delayBefore: 0
      overrideTypewriter: 0
      useTypewriter: 1
      pauseAfter: 0.25
      movementLock: 0
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - speaker: Cashier
      speakerColor: {r: 0, g: 0, b: 0, a: 0}
      text: Must be quiet at night.
      portrait: {fileID: 0}
      voiceClip: {fileID: 0}
      voiceVolume: 1
      soundEffect: {fileID: 0}
      delayBefore: 0
      overrideTypewriter: 0
      useTypewriter: 1
      pauseAfter: 0.25
      movementLock: 0
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - speaker: You
      speakerColor: {r: 0, g: 0, b: 0, a: 0}
      text: Usually.
      portrait: {fileID: 0}
      voiceClip: {fileID: 0}
      voiceVolume: 1
      soundEffect: {fileID: 0}
      delayBefore: 0
      overrideTypewriter: 0
      useTypewriter: 1
      pauseAfter: 0.25
      movementLock: 0
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - speaker: Cashier
      speakerColor: {r: 0.85, g: 0.05, b: 0.05, a: 1}
      text: Not tonight?
      portrait: {fileID: 0}
      voiceClip: {fileID: 0}
      voiceVolume: 1
      soundEffect: {fileID: 0}
      delayBefore: 0
      overrideTypewriter: 0
      useTypewriter: 1
      pauseAfter: 0.25
      movementLock: 0
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - speaker: You
      speakerColor: {r: 0, g: 0, b: 0, a: 0}
      text: What?
      portrait: {fileID: 0}
      voiceClip: {fileID: 0}
      voiceVolume: 1
      soundEffect: {fileID: 0}
      delayBefore: 0
      overrideTypewriter: 0
      useTypewriter: 1
      pauseAfter: 0.25
      movementLock: 0
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - speaker: Cashier
      speakerColor: {r: 0, g: 0, b: 0, a: 0}
      text: Nothing. Just making conversation.
      portrait: {fileID: 0}
      voiceClip: {fileID: 0}
      voiceVolume: 1
      soundEffect: {fileID: 0}
      delayBefore: 0
      overrideTypewriter: 0
      useTypewriter: 1
      pauseAfter: 0.25
      movementLock: 0
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - speaker: Cashier
      speakerColor: {r: 0.85, g: 0.05, b: 0.05, a: 1}
      text: You should get home soon.
      portrait: {fileID: 0}
      voiceClip: {fileID: 0}
      voiceVolume: 1
      soundEffect: {fileID: 0}
      delayBefore: 0.8
      overrideTypewriter: 0
      useTypewriter: 1
      pauseAfter: 0.25
      movementLock: 0
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - speaker: You
      speakerColor: {r: 0, g: 0, b: 0, a: 0}
      text: Why? Is something happening?
      portrait: {fileID: 0}
      voiceClip: {fileID: 0}
      voiceVolume: 1
      soundEffect: {fileID: 0}
      delayBefore: 0
      overrideTypewriter: 0
      useTypewriter: 1
      pauseAfter: 0.25
      movementLock: 0
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - speaker: Cashier
      speakerColor: {r: 0.85, g: 0.05, b: 0.05, a: 1}
      text: Stores close. Streets get empty. People get lost.
      portrait: {fileID: 0}
      voiceClip: {fileID: 0}
      voiceVolume: 1
      soundEffect: {fileID: 0}
      delayBefore: 0
      overrideTypewriter: 0
      useTypewriter: 1
      pauseAfter: 0.25
      movementLock: 0
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - speaker: You
      speakerColor: {r: 0, g: 0, b: 0, a: 0}
      text: That's... a weird thing to say.
      portrait: {fileID: 0}
      voiceClip: {fileID: 0}
      voiceVolume: 1
      soundEffect: {fileID: 0}
      delayBefore: 0
      overrideTypewriter: 0
      useTypewriter: 1
      pauseAfter: 0.25
      movementLock: 0
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - speaker: Cashier
      speakerColor: {r: 0.85, g: 0.05, b: 0.05, a: 1}
